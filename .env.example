# code-reviewer -- the environment.
#
# This reviewer reads local git and reports. It posts nothing and talks to no
# hosting system, so there is no repository token here: the only secret is the
# model's key. Turning findings into pull-request comments is a CI bot's job,
# downstream of the NDJSON the reviewer prints (--out).
#
# With a catalogue (~/.config/reviewer/config.yaml) this file holds only the
# secrets the catalogue NAMES: put it at ~/.config/reviewer/.env (chmod 600).
# Name the variables after what they hold; the LLM_*/REVIEW_* names below are
# the override layer and would apply to every project.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Without a catalogue: the environment describes the whole run ----------
# LLM_PROVIDER=local             # local (OpenAI-compatible: LM Studio / Ollama / vLLM) or claude
# LLM_API_KEY=lm-studio
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=qwen3-coder-next
# REVIEW_LANG=tr
# REVIEW_LOCAL_PATH=~/src/repo   # the checkout to review (default: the current directory)
# REVIEW_SKILLS_PATH=~/.config/reviewer/skills/repo
# REVIEW_SKILL_MAPPINGS={"medusa-route":["src/api/**/route.ts"]}
# REVIEW_PROMPT_FILES=prompts/system.md
# REVIEW_EXCLUDE_PATHS=**/*.md,**/*.spec.ts
# REVIEW_MAX_FINDINGS_PER_FILE=3
# REVIEW_VERIFY=true             # check findings against the diff and drop the refuted ones; --no-verify turns it off
# REVIEW_MAX_SKILL_CHARS=10000
# REVIEW_MAX_SKILLS_TOTAL_CHARS=18000
# REVIEW_MAX_CONTEXT_CHARS=6000
# PR_REVIEW_MAX_FILE_CHARS=8000
# REVIEW_MAX_CONCURRENT_FILES=5
# REVIEWER_CONFIG=               # another catalogue path
