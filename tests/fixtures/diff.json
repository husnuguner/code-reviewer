{
  "module": "diff",
  "cases": [
    {
      "name": "github_headerless",
      "input": {
        "patch": "@@ -1,4 +1,7 @@\n const a = 1;\n const b = 2;\n const c = 3;\n+const total = items.reduce((s, i) => s + i.price, 0);\n+const rows = await repo.find();\n+return rows;\n export {};\n"
      },
      "expected": {
        "added_lines": [
          4,
          5,
          6
        ],
        "new_side_index": [
          [
            1,
            "const a = 1;"
          ],
          [
            2,
            "const b = 2;"
          ],
          [
            3,
            "const c = 3;"
          ],
          [
            4,
            "const total = items.reduce((s, i) => s + i.price, 0);"
          ],
          [
            5,
            "const rows = await repo.find();"
          ],
          [
            6,
            "return rows;"
          ],
          [
            7,
            "export {};"
          ]
        ],
        "annotate_patch": "@@ -1,4 +1,7 @@\n const a = 1;\n const b = 2;\n const c = 3;\n[L4] +const total = items.reduce((s, i) => s + i.price, 0);\n[L5] +const rows = await repo.find();\n[L6] +return rows;\n export {};"
      }
    },
    {
