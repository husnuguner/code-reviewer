{
  "module": "config-file",
  "schema": "config.yaml: `settings` (how the reviewer runs) at the root beside `skills` (repository only). parse/* is the reviewer's own policy on a decoded file (version, where a setting may sit, what the machine's file may not say); build/* is what convict makes of one or two files under an environment (merge, precedence, coercion, unknown keys). Values as written; nothing is flattened.",
  "cases": [
    {
      "name": "parse/valid_repo",
      "input": {
        "home": "repo",
        "payload": {
          "version": 1,
          "settings": {
            "language": "tr",
            "llm": {
              "model": "claude-opus-4"
            }
          },
          "skills": {
            "path": "skills",
            "mappings": {
              "api-routes": [
                "src/api/**/route.ts"
              ]
            }
          }
        }
      },
      "expected": {
        "source": "/x/config.yaml",
        "home": "repo",
        "values": {
          "version": 1,
          "settings": {
            "language": "tr",
            "llm": {
              "model": "claude-opus-4"
            }
          },
          "skills": {
            "path": "skills",
            "mappings": {
              "api-routes": [
                "src/api/**/route.ts"
              ]
            }
          }
        }
      }
    },
    {
      "name": "parse/valid_machine",
      "input": {
        "home": "machine",
        "payload": {
          "version": 1,
          "settings": {
            "llm": {
              "provider": "claude",
              "model": "claude-sonnet-4-6",
              "api-key": "${ANTHROPIC_API_KEY}"
            },
            "language": "en"
          }
        }
      },
      "expected": {
        "source": "/x/config.yaml",
        "home": "machine",
        "values": {
          "version": 1,
          "settings": {
            "llm": {
              "provider": "claude",
              "model": "claude-sonnet-4-6",
              "api-key": "${ANTHROPIC_API_KEY}"
            },
            "language": "en"
          }
        }
      }
    },
    {
      "name": "parse/empty_object",
      "input": {
        "home": "repo",
        "payload": {}
      },
      "expected": {
        "source": "/x/config.yaml",
        "home": "repo",
        "values": {}
      }
    },
    {
      "name": "parse/version_99",
      "input": {
        "home": "repo",
        "payload": {
          "version": 99
        }
      },
      "expected": {
        "error": "ConfigFileError",
        "message": "/x/config.yaml declares schema version 99, but this build understands up to 1. Upgrade the reviewer."
      }
    },
    {
      "name": "parse/version_string",
      "input": {
        "home": "repo",
        "payload": {
          "version": "1"
        }
      },
      "expected": {
        "error": "ConfigFileError",
        "message": "/x/config.yaml declares schema version '1', but this build understands up to 1. Upgrade the reviewer."
      }
    },
    {
      "name": "parse/version_zero",
      "input": {
        "home": "repo",
        "payload": {
          "version": 0
        }
      },
      "expected": {
        "source": "/x/config.yaml",
        "home": "repo",
        "values": {
          "version": 0
        }
      }
    },
    {
      "name": "parse/version_null",
      "input": {
        "home": "repo",
        "payload": {
          "version": null
        }
      },
      "expected": {
        "error": "ConfigFileError",
        "message": "/x/config.yaml declares schema version null, but this build understands up to 1. Upgrade the reviewer."
      }
    },
    {
      "name": "parse/root_not_object",
      "input": {
        "home": "repo",
        "payload": [
          "not",
          "an",
          "object"
        ]
      },
      "expected": {
        "error": "ConfigFileError",
        "message": "/x/config.yaml must be an object, got array"
      }
    },
    {
      "name": "parse/root_null",
      "input": {
        "home": "repo",
        "payload": null
      },
      "expected": {
        "error": "ConfigFileError",
        "message": "/x/config.yaml must be an object, got null"
      }
    },
    {
      "name": "parse/setting_at_root",
      "input": {
        "home": "repo",
        "payload": {
          "llm": {
            "model": "x"
          },
          "language": "tr",
          "skills": {
            "path": "s"
          }
        }
      },
      "expected": {
        "error": "ConfigFileError",
        "message": "/x/config.yaml has ['language', 'llm'] at the root; a setting goes under the settings section."
      }
    },
    {
      "name": "parse/machine_skills_rejected",
      "input": {
        "home": "machine",
        "payload": {
          "skills": {
            "path": "~/x"
          }
        }
      },
      "expected": {
        "error": "ConfigFileError",
        "message": "/x/config.yaml sets ['skills'], which belongs to a repository's .review/config.yaml: it describes the reviewed code, not this machine."
      }
    },
    {
      "name": "build/repo_restates_a_setting",
      "input": {
        "machine": {
          "settings": {
            "language": "en",
            "max-findings-per-file": 3
          }
        },
        "repo": {
          "settings": {
            "language": "tr"
          }
        }
      },
      "expected": {
        "reviewLang": "Turkish",
        "maxFindingsPerFile": 3
      }
    },
    {
      "name": "build/llm_merges_key_by_key",
      "input": {
        "machine": {
          "settings": {
            "llm": {
              "provider": "claude",
              "model": "claude-sonnet-4-6"
            }
          }
        },
        "repo": {
          "settings": {
            "llm": {
              "model": "claude-opus-4"
            }
          }
        }
      },
      "expected": {
        "provider": "claude",
        "model": "claude-opus-4"
      }
    },
    {
      "name": "build/exclude_replaces_not_unions",
      "input": {
        "machine": {
          "settings": {
            "exclude": [
              "**/*.md"
            ]
          }
        },
        "repo": {
          "settings": {
            "exclude": [
              "**/*.spec.ts"
            ]
          }
        }
      },
      "expected": {
        "excludeGlobs": [
          "**/*.spec.ts"
        ]
      }
    },
    {
      "name": "build/exclude_as_csv_string",
      "input": {
        "machine": null,
        "repo": {
          "settings": {
            "exclude": "**/*.md, **/*.lock\n**/dist/**"
          }
        }
      },
      "expected": {
        "excludeGlobs": [
          "**/*.md",
          "**/*.lock",
          "**/dist/**"
        ]
      }
    },
    {
      "name": "build/skills_from_the_repo",
      "input": {
        "machine": {
          "settings": {
            "language": "en"
          }
        },
        "repo": {
          "skills": {
            "path": "skills",
            "mappings": {
              "a": "**",
              "b": [
                " x/** ",
                ""
              ]
            }
          }
        }
      },
      "expected": {
        "reviewLang": "English",
        "skillsPath": "skills",
        "skillMappings": {
          "a": [
            "**"
          ],
          "b": [
            "x/**"
          ]
        }
      }
    },
    {
      "name": "build/machine_alone",
      "input": {
        "machine": {
          "settings": {
            "llm": {
              "provider": "local"
            },
            "verify": false
          }
        },
        "repo": null
      },
      "expected": {
        "provider": "local",
        "verifyFindings": false
      }
    },
    {
      "name": "build/neither",
      "input": {
        "machine": null,
        "repo": null
      },
      "expected": {
        "provider": "local",
        "model": null,
        "reviewLang": "English",
        "verifyFindings": true,
        "excludeGlobs": [],
        "maxFindingsPerFile": 3,
        "skillsPath": "",
        "skillMappings": {}
      }
    },
    {
      "name": "build/unknown_setting",
      "input": {
        "machine": null,
        "repo": {
          "settings": {
            "exlude": [
              "*.md"
            ]
          }
        }
      },
      "expected": {
        "error": "ConfigError",
        "message": "configuration param 'settings.exlude' not declared in the schema"
      }
    },
    {
      "name": "build/old_layout_defaults_projects",
      "input": {
        "machine": {
          "defaults": {
            "language": "tr"
          },
          "projects": {
            "app": {}
          }
        },
        "repo": null
      },
      "expected": {
        "error": "ConfigError",
        "message": "configuration param 'defaults.language' not declared in the schema\nconfiguration param 'projects.app' not declared in the schema"
      }
    },
    {
      "name": "build/local_path_unknown",
      "input": {
        "machine": null,
        "repo": {
          "settings": {
            "local-path": "~/src/app"
          }
        }
      },
      "expected": {
        "error": "ConfigError",
        "message": "configuration param 'settings.local-path' not declared in the schema"
      }
    },
    {
      "name": "build/max_file_chars_removed",
      "input": {
        "machine": {
          "settings": {
            "max-file-chars": 8000
          }
        },
        "repo": null
      },
      "expected": {
        "error": "ConfigError",
        "message": "configuration param 'settings.max-file-chars' not declared in the schema"
      }
    },
    {
      "name": "build/skills_inside_settings",
      "input": {
        "machine": null,
        "repo": {
          "settings": {
            "skills": {
              "path": "s"
            }
          }
        }
      },
      "expected": {
        "error": "ConfigError",
        "message": "configuration param 'settings.skills.path' not declared in the schema"
      }
    },
    {
      "name": "build/llm_unknown_key",
      "input": {
        "machine": {
          "settings": {
            "llm": {
              "provider": "local",
              "apiKey": "K"
            }
          }
        },
        "repo": null
      },
      "expected": {
        "error": "ConfigError",
        "message": "configuration param 'settings.llm.apiKey' not declared in the schema"
      }
    },
    {
      "name": "build/every_error_at_once",
      "input": {
        "machine": null,
        "repo": {
          "settings": {
            "llm": {
              "provider": "gemini"
            },
            "max-findings-per-file": -1,
            "verify": "maybe"
          }
        }
      },
      "expected": {
        "error": "ConfigError",
        "message": "settings.verify: must be one of ['1', 'true', 'yes', 'on', '0', 'false', 'no', 'off']: value was \"maybe\"\nsettings.max-findings-per-file: must be a whole number: value was -1\nsettings.llm.provider: must be one of ['claude', 'local'], got: 'gemini': value was \"gemini\""
      }
    }
  ]
}
