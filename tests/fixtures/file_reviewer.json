        "text": "{\"findings\": []}"
      },
      "expected": {
        "findings": []
      }
    },
    {
      "name": "extract_json/fenced_json",
      "input": {
        "text": "```json\n{\"findings\": [{\"line\": 2}]}\n```"
      },
      "expected": {
        "findings": [
          {
            "line": 2
          }
        ]
      }
    },
    {
