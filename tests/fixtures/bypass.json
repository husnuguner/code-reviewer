      "expected": {
        "regions": [
          {
            "start": 1,
            "end": 4,
            "reason": "x"
          }
        ],
        "unreasoned": []
      }
    },
    {
      "name": "scan/Allman braces and an else-if chain",
      "input": [
        "// reviewer: by-pass - x",
        "if (a)",
