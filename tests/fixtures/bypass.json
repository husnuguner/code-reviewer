{
  "module": "bypass",
  "cases": [
    {
      "name": "scan/a marker names the function below it",
      "input": [
        "a();",
        "// reviewer: by-pass - legacy",
        "function f() {",
        "  if (x) {",
        "    y();",
        "  }",
        "}",
        "after();"
      ],
      "expected": {
        "regions": [
          {
            "start": 2,
            "end": 7,
            "reason": "legacy"
          }
        ],
        "unreasoned": []
      }
    },
    {
      "name": "scan/a marker on the head line names that statement",
      "input": [
        "function f() { // reviewer: by-pass - legacy",
        "  y();",
        "}",
        "after();"
      ],
      "expected": {
        "regions": [
          {
            "start": 1,
            "end": 3,
            "reason": "legacy"
          }
        ],
        "unreasoned": []
      }
    },
    {
      "name": "scan/a marker on a statement line names the one statement",
      "input": [
        "const url = \"http://x\"; // reviewer: by-pass - y",
        "next();"
      ],
      "expected": {
        "regions": [
          {
            "start": 1,
            "end": 1,
            "reason": "y"
          }
        ],
        "unreasoned": []
      }
    },
    {
      "name": "scan/an if block",
      "input": [
        "// reviewer: by-pass - x",
        "if (a) {",
        "  b();",
        "}",
