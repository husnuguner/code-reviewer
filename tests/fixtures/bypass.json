        "  b();",
        "}",
        "else if (c)",
        "{",
        "  d();",
        "}",
        "else",
        "{",
        "  e();",
        "}",
        "after();"
      ],
      "expected": {
        "regions": [
          {
            "start": 1,
            "end": 13,
            "reason": "x"
          }
        ],
        "unreasoned": []
      }
    },
    {
      "name": "scan/} else { and } catch { carry the block on",
      "input": [
        "// reviewer: by-pass - x",
        "try {",
        "  a();",
        "} catch (e) {",
        "  b();",
        "} finally {",
        "  c();",
        "}",
        "after();"
      ],
      "expected": {
        "regions": [
          {
            "start": 1,
            "end": 8,
            "reason": "x"
          }
        ],
        "unreasoned": []
      }
    },
    {
      "name": "scan/} else with its brace on the next line",
      "input": [
        "// reviewer: by-pass - x",
        "if (a) {",
        "  b();",
        "} else",
        "{",
        "  c();",
        "}",
        "d();"
