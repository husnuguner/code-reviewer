      },
      "expected": "src/a.ts:41-80 (validated upstream)"
    },
    {
      "name": "describe/one line",
      "input": {
        "path": "src/a.ts",
        "start_line": 41,
        "end_line": 41,
        "reason": "x"
      },
      "expected": "src/a.ts:41 (x)"
    },
    {
      "name": "warning/none",
      "input": [],
      "expected": ""
    },
    {
      "name": "warning/two regions sorted by path then line",
      "input": [
        {
          "path": "src/b.ts",
          "start_line": 1,
          "end_line": 3,
          "reason": "b"
        },
        {
          "path": "src/a.ts",
          "start_line": 41,
          "end_line": 80,
          "reason": "legacy"
        },
        {
          "path": "src/a.ts",
          "start_line": 5,
          "end_line": 5,
          "reason": "one"
        }
      ],
      "expected": "Review was bypassed by markers in the code in 3 region(s): src/a.ts:5 (one), src/a.ts:41-80 (legacy), src/b.ts:1-3 (b); read those yourself."
